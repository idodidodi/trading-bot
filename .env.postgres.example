# Copy to a NEW config directory. Never reuse the fallback installation's .env.
# Supply the shared SESSION pooler IPv4 host and the dedicated worker login.
# URL-encode special password characters. Passwords are never browser settings.
TRADING_DATABASE_URL=
# Example shape (no real credentials):
# postgresql://trading_worker.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/trusted-ca.crt
HOST=127.0.0.1
PORT=8080
DATA_DIR=/absolute/path/to/new-postgres-install/data
DRY_RUN=true
PAPER_TRADING_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DEVICE_LABEL=linux-postgres
# Preserve the UUID from the sender snapshot if desired; otherwise uses Postgres.
TELEGRAM_SENDER_ID=
# Add only the provider credentials needed by the imported configuration.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
TIINGO_API_KEY=
FMP_API_KEY=
# Browser public settings; optional if cloud/browser-config.json is installed.
DASHBOARD_SUPABASE_URL=
DASHBOARD_PUBLISHABLE_KEY=
DASHBOARD_INSTALLATION_ID=
# This migration branch never updates itself; do manual release replacement.
