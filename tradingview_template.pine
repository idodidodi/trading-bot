//@version=6
indicator("RSI divergence + BB · local Telegram", overlay=true, max_bars_back=500)
// Generated from skills/rsi-divergence/SKILL.md. Regenerate and recreate alerts after rule changes.
string webhookSecret = input.string("", "Webhook secret", tooltip="Use WEBHOOK_SECRET from your local .env. Do not enter your Telegram token here.")
int rsiPeriod = __RSI_PERIOD__
float rsiTolerance = __RSI_TOLERANCE__
int bbPeriod = __BB_PERIOD__
float bbMultiplier = __BB_MULTIPLIER__
int leftBars = __PIVOT_LEFT__
int rightBars = __PIVOT_RIGHT__
int minSpacing = __MIN_SPACING__
int maxSpacing = __MAX_SPACING__

float change = ta.change(close)
float avgGain = ta.rma(math.max(change, 0), rsiPeriod)
float avgLoss = ta.rma(math.max(-change, 0), rsiPeriod)
float rsi = na(avgGain) or na(avgLoss) ? na : avgGain == 0 and avgLoss == 0 ? 50 : avgLoss == 0 ? 100 : avgGain == 0 ? 0 : 100 - 100 / (1 + avgGain / avgLoss)
float basis = ta.sma(close, bbPeriod)
float deviation = bbMultiplier * ta.stdev(close, bbPeriod, true)
float lower = basis - deviation
float upper = basis + deviation
plot(basis, "BB basis", color=color.gray)
plot(lower, "BB lower", color=color.teal)
plot(upper, "BB upper", color=color.orange)

strictPivot(bool isLow) =>
    bool found = bar_index >= leftBars + rightBars
    float candidate = close[rightBars]
    for offset = 0 to leftBars + rightBars
        if offset != rightBars
            float other = close[offset]
            found := found and (isLow ? candidate < other : candidate > other)
    found

number(float value) =>
    str.tostring(value, "#.################")

payload(string direction, float price1, float price2, float rsi1, float rsi2, float band1, float band2, float touchPrice, int pivot1, int pivot2, int spacing) =>
    '{"secret":"' + webhookSecret + '","symbol":"' + syminfo.tickerid + '","timeframe":"' + timeframe.period + '","direction":"' + direction + '","price1":' + number(price1) + ',"price2":' + number(price2) + ',"rsi1":' + number(rsi1) + ',"rsi2":' + number(rsi2) + ',"band1":' + number(band1) + ',"band2":' + number(band2) + ',"band_touch_price":' + number(touchPrice) + ',"pivot1":' + str.tostring(pivot1) + ',"pivot2":' + str.tostring(pivot2) + ',"confirmed_at":' + str.tostring(time_close) + ',"spacing":' + str.tostring(spacing) + ',"rules":__RULES_JSON__}'

var lowIndices = array.new_int()
var highIndices = array.new_int()
bool bullish = false
bool bearish = false
bool lowPivot = strictPivot(true)
bool highPivot = strictPivot(false)
bool supportedChart = chart.is_standard and (timeframe.period == "240" or timeframe.period == "1D" or timeframe.period == "1W" or timeframe.period == "1M")

if barstate.isconfirmed and supportedChart
    int pivotIndex = bar_index - rightBars
    for direction = 0 to 1
        bool isLow = direction == 0
        references = isLow ? lowIndices : highIndices
        while array.size(references) > 0
            if pivotIndex - array.get(references, 0) > maxSpacing
                array.shift(references)
            else
                break
        bool found = isLow ? lowPivot : highPivot
        if found
            float band = isLow ? lower[rightBars] : upper[rightBars]
            float wick = isLow ? low[rightBars] : high[rightBars]
            bool bandTouch = not na(band) and (isLow ? wick <= band : wick >= band)
            if bar_index >= math.max(bbPeriod + leftBars + rightBars, math.max(rsiPeriod + 1, maxSpacing + leftBars + rightBars + 1)) - 1 and bandTouch and array.size(references) > 0
                for k = 0 to array.size(references) - 1
                    int spacing = pivotIndex - array.get(references, k)
                    int offset = rightBars + spacing
                    float firstBand = isLow ? lower[offset] : upper[offset]
                    bool divergence = isLow ? close[rightBars] < close[offset] and rsi[rightBars] >= rsi[offset] - rsiTolerance : close[rightBars] > close[offset] and rsi[rightBars] <= rsi[offset] + rsiTolerance
                    if spacing >= minSpacing and spacing <= maxSpacing and not na(firstBand) and divergence
                        bullish := bullish or isLow
                        bearish := bearish or not isLow
                        if str.length(webhookSecret) >= 32
                            alert(payload(isLow ? "bullish" : "bearish", close[offset], close[rightBars], rsi[offset], rsi[rightBars], firstBand, band, wick, time[offset], time[rightBars], spacing), alert.freq_all)
            array.push(references, pivotIndex)

// Mark confirmation candles, not the earlier pivot candles.
plotshape(bullish, title="Bullish confirmed", style=shape.triangleup, location=location.belowbar, color=color.lime, text="BULL")
plotshape(bearish, title="Bearish confirmed", style=shape.triangledown, location=location.abovebar, color=color.red, text="BEAR")
bgcolor(not supportedChart ? color.new(color.red, 85) : na, title="Unsupported chart/timeframe")
