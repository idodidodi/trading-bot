MODE=scanner
# Candidate market-data provider; enter a key locally only after confirming coverage.
TWELVE_DATA_API_KEY=
# OANDA v20 forex. Use credentials for the selected environment; keep them local.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
# Tiingo forex. Conservative free-plan request budgets, shared across processes.
TIINGO_API_KEY=
TIINGO_REQUESTS_PER_HOUR=50
TIINGO_REQUESTS_PER_DAY=1000
# Alpaca market data and optional simulated execution. Never sent to browser.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# sip = consolidated, delayed; iex = only IEX exchange
ALPACA_DATA_FEED=sip
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set true for local testing without sending Telegram messages.
DRY_RUN=false
HOST=127.0.0.1
PORT=8080
# Source runs default to dev: separate database, no activity logs/cloud writes,
# dry-run delivery and no paper orders. Production executables remain on PORT.
DEV_PORT=8082
# Initial default only; saved local Settings take precedence.
# Updated dev/prod senders compete through the shared coordinator.
DEV_TELEGRAM_ENABLED=false
# Readable sender label (default: hostname); sender UUID persists per data directory.
TELEGRAM_DEVICE_LABEL=
# Optional override; defaults to telegram-delivery beside CLOUD_SYNC_URL.
TELEGRAM_COORDINATION_URL=
# Initial default only; saved local Settings take precedence.
DEV_CLOUD_SYNC_ENABLED=false
# DEV_DATA_DIR=/absolute/path/to/development-data
ONLINE_DASHBOARD_URL=https://family-trading-bot.idodidodi.workers.dev
# Legacy TradingView mode only: MODE=webhook
# WEBHOOK_SECRET=
# WEBHOOK_PORT=8081

# Optional cloud mirror; disabled if either value is empty.
CLOUD_SYNC_URL=
CLOUD_SYNC_TOKEN=

# Momentum orders only; trading host is fixed to paper-api.alpaca.markets.
# Initial default; local Settings → Paper trading takes precedence after saving.
PAPER_TRADING_ENABLED=false
PAPER_RISK_PCT=1
PAPER_MAX_NOTIONAL=10000

# FMP cash-index daily history (intraday/DAX depend on subscription).
# Add your own key only in the local .env; never commit or enter it in the browser.
# Keep this template empty. Restart the scanner after editing local credentials.
# Setup paths and activation instructions: CHANGELOG.md / Settings > Changelog & FMP setup.
FMP_API_KEY=
